# Copia este archivo como .env y llena los valores de tu proyecto de Supabase
# (Supabase → Project Settings → API). Si lo dejas vacío, el sitio funciona
# con los datos de ejemplo de src/lib/defaultContent.js (sin guardar cambios).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
